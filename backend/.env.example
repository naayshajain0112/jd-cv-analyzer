PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jd-cv-analyzer?retryWrites=true&w=majority

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (e.g. http://localhost:5173 for dev, Vercel URL for prod)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=info
